/*
 *  kmod_info.c.in
 *
 *  Kernel module descriptor. Xcode generates an equivalent file for every
 *  kernel extension target; the Makefile does the same by filling in the
 *  @PLACEHOLDERS@ below (see "kmod_info" in the Makefile).
 *
 *  _start/_stop come from MacKernelSDK/Library/x86_64/libkmod.a, which expects
 *  this file to provide kmod_info, _realmain and _antimain.
 *  <NAME>_kern_start/_kern_stop are defined by Lilu's plugin_start.cpp.
 */

#include <mach/mach_types.h>

extern kern_return_t _start(kmod_info_t *ki, void *data);
extern kern_return_t _stop(kmod_info_t *ki, void *data);

extern kern_return_t @NAME@_kern_start(kmod_info_t *ki, void *data);
extern kern_return_t @NAME@_kern_stop(kmod_info_t *ki, void *data);

__attribute__((visibility("default"))) KMOD_EXPLICIT_DECL(@BUNDLE_ID@, "@VERSION@", _start, _stop)

__private_extern__ kmod_start_func_t *_realmain = @NAME@_kern_start;
__private_extern__ kmod_stop_func_t *_antimain = @NAME@_kern_stop;
__private_extern__ int _kext_apple_cc = __APPLE_CC__;
